# Copy to .env and fill in. .env is git-ignored. AI model keys are NOT set here -
# add them in the app under Settings → AI models (they are encrypted in the database).

# Required in production: encrypts every stored secret. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ARIAX_MASTER_KEY=

# Public URL people use to reach Aria XAI (used in invite links and the widget snippet)
ARIAX_BASE_URL=http://localhost:8700

# docker-compose Postgres password
POSTGRES_PASSWORD=

# Optional
# ARIAX_ENV=production
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/ariax
# ARIAX_COOKIE_SECURE=1
# ARIAX_BLOCK_PRIVATE_NETWORKS=1   # stop customer connections reaching private IPs (on by default in production)
# ARIAX_UPLOAD_LIMIT_MB=25
